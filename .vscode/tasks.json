{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            // use cmd and taskkill to close any running exe before compiling
            "command": "cmd",
            "args": [
                "/c",
                "taskkill /F /IM main.exe 2>nul & \"C:\\MinGW\\bin\\gcc.EXE\" -Wall -Wextra -g3 \"${workspaceFolder}\\main.c\" -o \"${workspaceFolder}\\output\\main.exe\""
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },

        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}\\output\\main.exe",
            "problemMatcher": []
        },
        {
            "label": "build and run",
            "dependsOn": ["build"],
            "type": "shell",
            "command": "${workspaceFolder}\\output\\main.exe",
            "problemMatcher": []
        }
    ]
}